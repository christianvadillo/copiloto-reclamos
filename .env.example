# Copiloto de reclamos — variables de entorno (prefijo COPILOTO_).
# Copia este archivo a `.env` y complétalo. `Settings.from_env()` lee `os.environ`
# directamente (sin pydantic-settings): exporta las variables antes de correr `copiloto`,
# por ejemplo con `set -a; source .env; set +a` o con tu gestor de procesos.

# ── Credenciales de la app de Mercado Libre (DevCenter) ────────────────────────────────────
COPILOTO_APP_ID=
COPILOTO_CLIENT_SECRET=
COPILOTO_REDIRECT_URI=http://localhost:8000/oauth/callback

# ── Cifrado en reposo de los tokens OAuth (Fernet). Genera uno fijo y consérvalo: ──────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta variable, `Settings.from_env()` genera una llave nueva EN CADA ARRANQUE (los
# tokens guardados con la llave anterior dejan de poder leerse). Fíjala en producción.
COPILOTO_SECRET_KEY=

# ── Almacenamiento ──────────────────────────────────────────────────────────────────────────
COPILOTO_DB_PATH=data/copiloto.db

# ── Endpoints de Mercado Libre (normalmente no hace falta tocarlos) ────────────────────────
COPILOTO_MELI_BASE_URL=https://api.mercadolibre.com
COPILOTO_AUTH_BASE_URL=https://auth.mercadolibre.com.mx

# ── Política de ejecución: shadow (solo recomienda) | approve (todo con visto bueno) | auto ──
COPILOTO_MODE=shadow
COPILOTO_AUTO_MAX_AMOUNT=1500
COPILOTO_MIN_PROB_BEST=0.6

# ── Redacción ────────────────────────────────────────────────────────────────────────────────
COPILOTO_MESSAGE_MAX_CHARS=350
COPILOTO_LLM_MODEL=claude-opus-5
COPILOTO_LLM_EFFORT=medium
# Por defecto: true si ANTHROPIC_API_KEY está definida, false si no. Puedes forzarlo:
COPILOTO_LLM_ENABLED=
# La API key la lee el SDK oficial directo del entorno (no tiene prefijo COPILOTO_):
ANTHROPIC_API_KEY=

# ── Webhook / seguridad ────────────────────────────────────────────────────────────────────
COPILOTO_IP_ALLOWLIST_ENABLED=false
COPILOTO_TRUSTED_PROXY=false

# ── Evidencia local (fotos que el vendedor ya guardó al empacar, opcional) ─────────────────
# Layout esperado: <dir>/<order_id>/*.{jpg,png,pdf}
COPILOTO_EVIDENCE_PHOTOS_DIR=

# ── Economía: cómo se calculan los montos de decision.domain.Economics ────────────────────
COPILOTO_LEVEL_DROP_COST=30000
COPILOTO_COGS_RATIO=0.6
# CSV opcional "sku,unit_cost" con costo real por SKU (si falta un SKU, se usa COGS_RATIO):
COPILOTO_SKU_COSTS_PATH=
COPILOTO_RETURN_SHIPPING_COST=120
COPILOTO_RESEND_SHIPPING_COST=120
COPILOTO_HANDLING_COST=40
COPILOTO_MEDIATION_LABOR_COST=150
COPILOTO_EXCHANGE_AVAILABLE=false

# ── Identidad de la tienda (va en los mensajes redactados) ─────────────────────────────────
COPILOTO_STORE_NAME=Mi Tienda
COPILOTO_SIGNATURE=El equipo de Mi Tienda

# ── Operación ────────────────────────────────────────────────────────────────────────────────
COPILOTO_RECONCILE_INTERVAL_MIN=15
# Basic auth del dashboard (opcional; sin estas dos, el dashboard queda abierto):
COPILOTO_DASHBOARD_USER=
COPILOTO_DASHBOARD_PASSWORD=

# ── Usuarios de prueba (scripts/crear_usuarios_prueba.py, no lo usa el servicio) ───────────
COPILOTO_TEST_ACCESS_TOKEN=
